<Project>

  <!-- Auto-imported by any Microsoft.Build.Sql project that references this package (NuGet imports
       build/<PackageId>.props at the top of the consumer's build). Compiles this package's schema SOURCE
       into the consumer's own model, so audit.* objects land physically in the consuming dacpac
       (self-contained — no composite reference, no co-located dacpac). -->
  <ItemGroup>
    <Build Include="$(MSBuildThisFileDirectory)../sql/*.sql" />
  </ItemGroup>

  <!-- Expose this package's includable seed/ folder as a SQLCMD variable named after the package
       (dots → underscores; SQLCMD names cannot contain dots). The consumer's post-deployment then
       does just :r $(Sencilla_Component_Audit)/ApplyData.sql. -->
  <ItemGroup>
    <SqlCmdVariable Include="Sencilla_Component_Audit">
      <DefaultValue>$(MSBuildThisFileDirectory)../seed</DefaultValue>
      <Value>$(MSBuildThisFileDirectory)../seed</Value>
    </SqlCmdVariable>
  </ItemGroup>

</Project>
